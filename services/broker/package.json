{
  "name": "@disfap/broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DisFAP session gateway: token redemption, Guacamole instruction filtering, guacd tunnel",
  "main": "dist/server.js",
  "types": "src/server.ts",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./src/*.js": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./dist/*"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
