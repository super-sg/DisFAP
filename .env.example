# -----------------------------------------------------------------------------
# DisFAP — minimal environment template
# -----------------------------------------------------------------------------
# Copy to `.env` at the repository root and fill in the blanks:
#
#   cp .env.example .env
#
# `scripts/start-all.mjs` (npm start / npm run dev) reads `.env`, and falls back
# to `.env.dev.example` when it is absent.
#
# This file covers the **local, zero-cloud** setup. For the fuller local demo
# (OIDC, guest provisioning, durable credential keys, CORS) read
# `.env.dev.example`; for a deployed stack (TLS, Vault, Stripe, real AWS) read
# `deploy/.env.example`. Never commit a real `.env`.
# -----------------------------------------------------------------------------

# development | staging | production
# `production` refuses every development fallback below.
DFAP_ENV=development

# --- HTTP surface -------------------------------------------------------------
API_PORT=3000
# Fastify binds all interfaces by default; restrict it in a container.
# API_HOST=127.0.0.1

# --- Session-token signing ----------------------------------------------------
# 32-byte HMAC-SHA256 secret, base64, with a key id: `kid:<base64>`.
# Generate one — do not ship a real key in a file:
#   echo "kdev:$(openssl rand -base64 32)"
# Rotating a key: add the new key first, switch DFAP_SIGNING_KID, then keep the
# old key listed (verify-only) until its longest-lived token has expired.
#
# Left unset below, so `npm start` uses its documented local-only default.
# Set it explicitly for anything you intend to keep:
# DFAP_SIGNING_KEYS=kdev:<base64>
# DFAP_SIGNING_KID=kdev

# --- Database -----------------------------------------------------------------
# Requires PostgreSQL. The integration suite self-skips when this is unreachable.
DATABASE_URL=postgresql://disfap:disfap@localhost:5432/disfap?schema=public

# --- Session disconnect lifecycle ---------------------------------------------
# A dropped pixel tunnel keeps the VM and rental alive for this long so a page
# refresh / network flap / broker restart can reconnect. The deadline is
# persisted in Postgres, so it survives an API restart; a durable reaper ends
# the session after it.
# DFAP_SESSION_DISCONNECT_GRACE_S=30   # 5..600
# DFAP_SESSION_REAPER_INTERVAL_S=15    # 5..300

# --- Provisioning provider ----------------------------------------------------
# fake = in-memory, no network, no cost. aws = real EC2 (see AWS_* below).
CLOUD_PROVIDER=fake

# Real EC2 only. Region/AMI/type are validated at startup; the launch template
# owns the actual VM spec (see docs/adr/001-warm-pool-over-terraform-per-session.md).
# AWS_REGION=ap-south-1
# AWS_LAUNCH_TEMPLATE_ID=lt-00000000000000000
# AWS_SESSION_AMI_ID=ami-00000000000000000
# AWS_SESSION_INSTANCE_TYPE=t4g.small
# AWS_SESSION_ARCHITECTURE=arm64
# AWS_SESSION_VOLUME_GIB=20
# Prefer an AWS SSO profile (`AWS_PROFILE`) over static keys. Never commit keys.

# --- Remote desktop -----------------------------------------------------------
# guacd translates the Guacamole protocol to RDP/VNC. Runs locally; the broker
# connects to it over loopback.
GUACD_HOST=127.0.0.1
GUACD_PORT=4822
# The session credential is injected over this channel. Production requires
# GUACD_TLS=true + GUACD_CA (+ GUACD_CERT/GUACD_KEY); cleartext is refused there
# unless GUACD_ALLOW_CLEARTEXT=true explicitly asserts a private-only network.
GUACD_TLS=false
# GUACD_CA=/etc/dfap/guacd-ca.pem
# GUACD_CERT=/etc/dfap/broker-client.pem
# GUACD_KEY=/etc/dfap/broker-client-key.pem

# --- Vault (session credentials) ---------------------------------------------
# Absent => the in-memory FakeVaultClient (development only; production refuses).
# The app must use a scoped identity, never a root token:
#   VAULT_APPROLE_ROLE_ID / VAULT_APPROLE_SECRET_ID(_FILE)  <- preferred
#   VAULT_TOKEN / VAULT_TOKEN_FILE                          <- static fallback
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_APPROLE_ROLE_ID=
# VAULT_APPROLE_SECRET_ID_FILE=/run/secrets/vault_secret_id
# VAULT_MOUNT=secret
# In production VAULT_ADDR must be https:// unless VAULT_ALLOW_HTTP=true
# explicitly acknowledges a private-only hop.

# --- Broker -------------------------------------------------------------------
BROKER_PORT=8080
BROKER_WS_PATH=/tunnel
# Base URL only — the browser appends BROKER_WS_PATH itself.
BROKER_URL=ws://localhost:8080
CONNECT_TOKEN_TTL_S=60
CREDENTIAL_TTL_S=900
MAX_CLIENT_VIOLATIONS=5

# --- Authentication -----------------------------------------------------------
# deny        = every request rejected (the production-safe default)
# dev-header  = trust x-dfap-user / x-dfap-org; roles still come from the database.
#               REFUSED when DFAP_ENV=production.
# oidc        = verify a real OIDC/JWT access token (see
#               docs/runbooks/oidc-production-onboarding.md)
DFAP_AUTH_MODE=dev-header

# Exact browser origins allowed to make credentialed requests (comma-separated).
# Wildcards are rejected. Empty means no cross-origin browser access.
DFAP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Development-only fallbacks ----------------------------------------------
# Fabricates session/teardown results and degrades the marketplace to an
# in-memory catalog when Postgres is unreachable. REFUSED in production.
DFAP_DEV_FALLBACK=true

# --- Frontend (Vite, build-time) ---------------------------------------------
# The API base is proxied by Vite in development, so these stay unset locally.
# VITE_API_BASE_URL=http://localhost:3000
# VITE_WS_URL=ws://localhost:8080
