# DisFAP Local Development Environment
# Copy this file to .env.dev or export these variables for running locally without Docker/AWS.

DFAP_ENV=development
API_PORT=3000
BROKER_PORT=8080
BROKER_WS_PATH=/tunnel
BROKER_URL=ws://localhost:8080/tunnel

# 32-byte HMAC-SHA256 signing key (base64)
DFAP_SIGNING_KEYS=kdev:gq12DUvetTrtZXQvojb2GIHtv9G9BBkA65jLOQTSTmc=
DFAP_SIGNING_KID=kdev

# Database connection (Prisma)
DATABASE_URL=postgresql://disfap:disfap@localhost:5432/disfap?schema=public

# Providers (fake for zero-cloud local testing)
CLOUD_PROVIDER=fake
GUACD_HOST=127.0.0.1
GUACD_PORT=4822
GUACD_TLS=false
MAX_CLIENT_VIOLATIONS=5
CONNECT_TOKEN_TTL_S=60
CREDENTIAL_TTL_S=900

# Explicit development fallbacks: fabricate session/teardown results and
# degrade the marketplace to an in-memory seeded catalog when Postgres is
# unreachable. Defaults to false and is REFUSED when DFAP_ENV/NODE_ENV is
# "production". Set true for local dev only.
DFAP_DEV_FALLBACK=true

# Inbound authentication (audit C4). Default is `deny`: with no identity
# provider wired, every request is rejected. `dev-header` reads identity from
# x-dfap-user / x-dfap-org (roles still come from the DB, never a header) and is
# REFUSED when DFAP_ENV/NODE_ENV is "production". Local development only.
DFAP_AUTH_MODE=dev-header

# Exact browser origins allowed to make credentialed cross-origin requests
# (comma-separated). Empty by default = no cross-origin browser access. Wildcards
# are rejected. Add the local Vite origin for dev.
DFAP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Per owner-rentee pair-key master (spec TA-4). Base64, ≥32 bytes:
#   openssl rand -base64 32
# UNSET in dev derives a non-secret deterministic fallback so derived keys
# survive a restart. Production MUST set this (config refuses to boot without it).
# DFAP_PAIR_MASTER_KEY=

# Durable owner-credential key provider (Layer 2). UNSET in dev uses a durable
# key file at services/api/.dfap/credential-key.pem (gitignored), so ciphertext
# survives a restart. Production MUST set one of these — config refuses an
# ephemeral key:
#   DFAP_CREDENTIAL_KEY_FILE=/run/secrets/dfap-credential-key.pem
#   DFAP_CREDENTIAL_KEY_PEM=<base64 of a PKCS#8 PEM>
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out key.pem
# Rotation: keep previous keys decrypt-only via DFAP_CREDENTIAL_KEY_RETIRED_PEMS.
# See docs/runbooks/key-management.md.
# DFAP_CREDENTIAL_KEY_FILE=
# DFAP_CREDENTIAL_KEY_PEM=
# DFAP_CREDENTIAL_KEY_RETIRED_PEMS=

# -----------------------------------------------------------------------------
# Guest credential provisioning (audit C3 / M8). Default `disabled`: the
# /internal/guest/provision endpoint returns 503 and no guest login is exposed.
#
# `instance-identity` requires the AWS regional instance-identity PUBLIC key
# (PEM or file) and is REFUSED in production until real AWS verification has
# been validated against live IMDS + AWS certs (see docs/runbooks/guest-provisioning.md).
# For local/CI testing, supply a generated key and bundle the matching public
# key into the image; that only proves the contract, not real VM isolation.
# DFAP_GUEST_PROVISIONING=instance-identity
# DFAP_GUEST_IDENTITY_CERT_FILE=/etc/dfap/aws-instance-identity.pem
# DFAP_GUEST_IDENTITY_CERT_PEM=
# DFAP_GUEST_PROVISIONING_TTL_S=900
# DFAP_GUEST_PROVISIONING_MAX_DELIVERIES=10
#
# Guest side (set in the image's /etc/dfap/provision.env, not here): the guest
# fails closed unless DFAP_PROVISIONING_ENABLED=1 and DFAP_CONTROL_PLANE_URL is
# set; until then the xrdp gate keeps the RDP listener DOWN.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Frontend OIDC login (Auth Code + PKCE) — Vite build-time vars for apps/web.
# UNSET locally: the web app runs without login (dev), and the API above uses
# `dev-header`. To exercise real provider login, start a local OIDC provider and
# set these before `npm run dev:web` (they are read by Vite at build/start time):
#   VITE_OIDC_ISSUER=https://login.example.com/
#   VITE_OIDC_CLIENT_ID=<public client id>   # no client secret in a browser
#   VITE_OIDC_AUDIENCE=https://api.example.com
#   VITE_OIDC_REDIRECT_PATH=/auth/callback
# Then set the API to `DFAP_AUTH_MODE=oidc` with the matching issuer/audience.
# See docs/runbooks/oidc-production-onboarding.md.
# -----------------------------------------------------------------------------
