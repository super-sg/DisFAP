# =============================================================================
# DisFAP Phase-0 environment — copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored (repo .gitignore: `.env.*` except `.env.example`).
# NEVER commit real secrets. Every value below marked "CHANGE ME" must be set
# to a strong, unique value before this stack is exposed anywhere.
# =============================================================================

# -----------------------------------------------------------------------------
# DFAP1 connect-token signing (HMAC-SHA256 keyring). Shared by api (mints) and
# broker (verifies). Format: DFAP_SIGNING_KEYS="<kid>:<base64key>[,<kid2>:<b64>]"
# The active kid used for minting is DFAP_SIGNING_KID and MUST be present in the
# keyring. Keys must be >= 32 bytes (the broker rejects shorter ones).
#
# Generate a fresh key (32 random bytes, base64):
#     openssl rand -base64 32
# Or just run `make gen-keys` and paste both lines it prints.
# -----------------------------------------------------------------------------
DFAP_SIGNING_KEYS=k20260722:CHANGE_ME_base64_32_bytes_from_openssl_rand_base64_32
DFAP_SIGNING_KID=k20260722

# -----------------------------------------------------------------------------
# Postgres (control-plane DB). POSTGRES_* seed the container; DATABASE_URL is
# what the api (Prisma) connects with — keep the credentials in sync.
# Host is the compose service name `postgres` on the private network.
# -----------------------------------------------------------------------------
POSTGRES_USER=disfap
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=disfap
DATABASE_URL=postgresql://disfap:CHANGE_ME_strong_db_password@postgres:5432/disfap?schema=public

# -----------------------------------------------------------------------------
# Redis (DFAP1 jti nonce burn-list). Password-protected; host is `redis`.
# REDIS_URL embeds the password (note the leading `:` before it).
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379

# -----------------------------------------------------------------------------
# Vault (session credential broker). Host is `vault` on the private network.
# VAULT_ADDR is also hard-wired in compose; kept here for the api/broker code
# and for CLI use. VAULT_TOKEN is set AFTER you initialise + unseal Vault the
# first time (README "Initialise & unseal Vault") — leave blank until then.
# -----------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=

# -----------------------------------------------------------------------------
# Marketplace pair-key master (services/api). Base64, >=32 bytes:
#   openssl rand -base64 32
# Used to derive the unique per owner-rentee credential key (spec TA-4).
# REQUIRED in production: config refuses to boot with the non-secret dev seed.
# -----------------------------------------------------------------------------
DFAP_PAIR_MASTER_KEY=

# -----------------------------------------------------------------------------
# Durable owner-credential key (services/api, Layer 2). REQUIRED in production:
# config refuses to boot without one (never an ephemeral key). Pick ONE source:
#   DFAP_CREDENTIAL_KEY_FILE — path to a PKCS#8 PEM (0600). Mount a secret/file.
#   DFAP_CREDENTIAL_KEY_PEM  — base64 of the same PEM, for env-injected secrets.
# Generate a key (RSA-4096):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out key.pem
# Rotation: move the previous key to DFAP_CREDENTIAL_KEY_RETIRED_PEMS
# (comma-separated base64 PEMs, decryption-only) and swap the active key.
# See docs/runbooks/key-management.md.
# -----------------------------------------------------------------------------
# DFAP_CREDENTIAL_KEY_FILE=/run/secrets/dfap-credential-key.pem
# DFAP_CREDENTIAL_KEY_PEM=
# DFAP_CREDENTIAL_KEY_RETIRED_PEMS=

# -----------------------------------------------------------------------------
# Development fallbacks (services/api). MUST stay false (or unset) here: when
# true the control plane fabricates session/teardown results and serves an
# in-memory catalog if Postgres is unavailable — never acceptable for a real
# deployment. The api refuses to boot with this enabled under NODE_ENV=production.
# Local dev without Docker sets it true via scripts/start-all.mjs.
# -----------------------------------------------------------------------------
DFAP_DEV_FALLBACK=false

# -----------------------------------------------------------------------------
# guacd (Guacamole proxy). Host is the compose service name; broker<->guacd
# stays on the private bridge in Phase-0 so TLS is disabled on that hop.
# -----------------------------------------------------------------------------
GUACD_HOST=guacd
GUACD_PORT=4822
GUACD_TLS=false

# -----------------------------------------------------------------------------
# Broker (services/broker) tunables. Defaults match services/broker/src/config.ts.
# -----------------------------------------------------------------------------
BROKER_PORT=8080
BROKER_WS_PATH=/tunnel
MAX_CLIENT_VIOLATIONS=5

# -----------------------------------------------------------------------------
# API (services/api) tunables.
# -----------------------------------------------------------------------------
API_PORT=3000

# -----------------------------------------------------------------------------
# Stripe billing (services/api). Test keys for local dev; live keys in prod.
# STRIPE_WEBHOOK_SECRET verifies the webhook delivered to /api/billing/webhook.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_ID=price_CHANGE_ME

# -----------------------------------------------------------------------------
# Inbound authentication + browser CORS (control plane).
#
# DFAP_AUTH_MODE:
#   deny        (default) — reject every request. Correct until an identity
#                           provider is wired; the API serves nothing.
#   dev-header            — LOCAL DEV ONLY. Refused in production by config.
#   oidc                  — verify OIDC/JWT access tokens (production path).
#                           Requires DFAP_OIDC_ISSUER + DFAP_OIDC_AUDIENCE.
#
# DFAP_CORS_ALLOWED_ORIGINS: exact, comma-separated browser origins allowed to
# make credentialed cross-origin requests, e.g. https://app.example.com. Empty
# (the default) denies all cross-origin browser access. Wildcards are rejected.
#
# OIDC settings (only read when DFAP_AUTH_MODE=oidc). The issuer is matched
# EXACTLY and the audience must be the API's resource identifier — never the
# SPA's client id (that would accept ID tokens). Keys are fetched from a
# server-configured JWKS (explicit URL below, or OIDC discovery at the issuer);
# a client can never supply a key. Leave these blank while the mode is `deny`.
# -----------------------------------------------------------------------------
DFAP_AUTH_MODE=deny
DFAP_CORS_ALLOWED_ORIGINS=

# DFAP_OIDC_ISSUER=https://login.example.com/
# DFAP_OIDC_AUDIENCE=https://api.example.com
# DFAP_OIDC_JWKS_URL=
# DFAP_OIDC_ALGORITHMS=RS256
# DFAP_OIDC_CLOCK_TOLERANCE_S=5
# DFAP_OIDC_ORG_CLAIM=
# DFAP_OIDC_ACCESS_TOKEN_TYP=

# -----------------------------------------------------------------------------
# Guest credential provisioning (audit C3 / M8).
#
# DFAP_GUEST_PROVISIONING:
#   disabled          (default) — /internal/guest/provision returns 503.
#   instance-identity — verify an AWS-signed EC2 instance identity document,
#                       enforce the server-side instance→session binding, and
#                       deliver the session credential once. Requires
#                       DFAP_GUEST_IDENTITY_CERT_FILE or _PEM (the AWS regional
#                       instance-identity PUBLIC key).
#
# REFUSED in production by config until real AWS instance-identity verification
# has been validated (see docs/runbooks/guest-provisioning.md). Do NOT enable it
# in production on the strength of the unit tests — they use generated keys.
# -----------------------------------------------------------------------------
DFAP_GUEST_PROVISIONING=disabled
# DFAP_GUEST_IDENTITY_CERT_FILE=/etc/dfap/aws-instance-identity.pem
# DFAP_GUEST_IDENTITY_CERT_PEM=
# DFAP_GUEST_PROVISIONING_TTL_S=900
# DFAP_GUEST_PROVISIONING_MAX_DELIVERIES=10
# DFAP_OIDC_TOKEN_USE_CLAIM=token_use
# DFAP_OIDC_TOKEN_USE_VALUE=access
# DFAP_OIDC_REQUIRE_TOKEN_USE=false
# DFAP_OIDC_JWKS_CACHE_MAX_AGE_S=600
# DFAP_OIDC_JWKS_COOLDOWN_S=30

# -----------------------------------------------------------------------------
# AWS (services/api pool manager + reaper). On EC2, PREFER the instance IAM
# role and leave the static keys blank. Locally, set keys for a low-privilege
# IAM user. AWS_REGION is required either way.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Edge / TLS (Caddy). DFAP_SITE_ADDRESS is `localhost` for local dev (self-
# signed cert via Caddy's internal CA) or your FQDN in production (Caddy then
# auto-provisions Let's Encrypt using CADDY_ACME_EMAIL).
# -----------------------------------------------------------------------------
DFAP_SITE_ADDRESS=localhost
CADDY_ACME_EMAIL=admin@localhost

# -----------------------------------------------------------------------------
# Web client PUBLIC URLs — BAKED IN AT BUILD TIME by Vite (build args in
# compose). After changing any of these, rebuild the web image: `make build web`.
# For a real domain set these to https://<fqdn>/api and wss://<fqdn>/tunnel.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_WS_URL=wss://localhost/tunnel
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# -----------------------------------------------------------------------------
# Web client OIDC login (Authorization Code + PKCE). Also BAKED IN AT BUILD TIME
# (rebuild the web image after changing). Leave unset to run the web app WITHOUT
# login; when set, the app gates the UI behind a real provider login and sends
# only the access token intended for the API as `Authorization: Bearer`.
#   VITE_OIDC_ISSUER     — issuer / discovery URL (must equal the API's DFAP_OIDC_ISSUER)
#   VITE_OIDC_CLIENT_ID  — PUBLIC client id (there is no client secret in a browser)
#   VITE_OIDC_AUDIENCE   — the API resource id (must equal DFAP_OIDC_AUDIENCE)
#   VITE_OIDC_REDIRECT_PATH — default /auth/callback; register it at the provider
# Tokens are held in memory only (never localStorage).
# See docs/runbooks/oidc-production-onboarding.md.
# -----------------------------------------------------------------------------
# VITE_OIDC_ISSUER=https://login.example.com/
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_AUDIENCE=https://api.example.com
# VITE_OIDC_AUDIENCE_PARAM=audience
# VITE_OIDC_SCOPE=openid profile email
# VITE_OIDC_REDIRECT_PATH=/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
