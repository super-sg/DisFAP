# Build-context excludes for broker.Dockerfile (BuildKit reads this file next to
# the Dockerfile; patterns are relative to the build context = repo root).
# Keeps the host's node_modules / .git / secrets / build junk OUT of the image
# build so `npm ci` installs cleanly and no .env is ever copied in.
**/node_modules
.git
**/dist
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/coverage
**/*.log
**/.DS_Store
deploy/**
DisFAP Flow*.png
