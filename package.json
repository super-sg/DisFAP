{
  "name": "disfap",
  "private": true,
  "version": "0.1.0",
  "description": "DisFAP — secure workspace-as-a-service: brokered, ephemeral, pixel-only remote sessions",
  "workspaces": [
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
